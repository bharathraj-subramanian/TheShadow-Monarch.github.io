---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Bharathraj Subramanian" description="This address is not part of the site." noindex>
  <section class="plain">
    <div class="wrap">
      <div class="grid">
        <h1>404</h1>
        <p class="lede">
          That address is not part of this site. It may have moved, or the link that brought you here may be wrong.
        </p>
        <p class="link-row">
          <a href="/">Home</a>
          <a href="/#work">Work</a>
          <a href="/#contact">Contact</a>
        </p>
      </div>
    </div>
  </section>
</Base>
